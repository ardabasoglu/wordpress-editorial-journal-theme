{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1120px"
    },
    "color": {
      "palette": [
        { "slug": "arda-bg", "name": "Arda Background", "color": "#F6F8FB" },
        { "slug": "arda-paper", "name": "Arda Paper", "color": "#FFFFFF" },
        { "slug": "arda-ink", "name": "Arda Ink", "color": "#111827" },
        { "slug": "arda-muted", "name": "Arda Muted", "color": "#42526B" },
        { "slug": "arda-accent", "name": "Arda Accent", "color": "#2563EB" },
        { "slug": "arda-border", "name": "Arda Border", "color": "#D8E2F0" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "Fraunces, Georgia, 'Times New Roman', serif",
          "name": "Editorial Serif",
          "slug": "editorial-serif"
        },
        {
          "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
          "name": "Clean Sans",
          "slug": "clean-sans"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "#F6F8FB",
      "text": "#111827"
    },
    "typography": {
      "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "fontSize": "18px",
      "lineHeight": "1.55"
    },
    "elements": {
      "link": { "color": { "text": "#111827" } },
      "heading": {
        "typography": {
          "fontFamily": "Fraunces, Georgia, 'Times New Roman', serif",
          "fontWeight": "700",
          "lineHeight": "1.05"
        }
      }
    }
  }
}
